# Embeds the three TR-909 sample ROMs into a C++ include. Fails the build if any is missing or not
# the exact dump (SHA-256), so a device without hats, crash or ride can never be built.
# -DDIR=<folder with the ROMs> -DOUT=<roms.inc>
set(names hn61256p__c43.ic69 hn61256p__c42.ic62 hn61256p__c44.ic54)
set(vars kRomHihat kRomCrash kRomRide)
set(sums e43ff23f9b12e842e282e4dbd45db4cc41a1a361985f00266366d6865baa468a
         4b1b0fbda6254445021f5845f912a965a405bc260707e9b88523728fc7ed9c3e
         b7c643f77767328686ef520e599d5567fa0066201069170873f03b18e3fa9c72)
set(text "// generated by embed_roms.cmake - do not edit\n")
foreach(i RANGE 2)
  list(GET names ${i} name)
  list(GET vars ${i} var)
  list(GET sums ${i} want)
  set(path "${DIR}/${name}")
  if(NOT EXISTS "${path}")
    message(FATAL_ERROR "DIODE 909: sample ROM missing: ${path} (decrypt roms/tr909-roms.tar.enc first)")
  endif()
  file(SHA256 "${path}" got)
  if(NOT got STREQUAL want)
    message(FATAL_ERROR "DIODE 909: ${name} is not the expected ROM (sha256 ${got})")
  endif()
  file(READ "${path}" hex HEX)
  string(REGEX REPLACE "(..)" "0x\\1," hex "${hex}")
  string(APPEND text "alignas(16) static const unsigned char ${var}[32768] = {${hex}};\n")
endforeach()
file(WRITE "${OUT}.tmp" "${text}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
